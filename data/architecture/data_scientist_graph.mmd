---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	create_notebook(create_notebook)
	tools(tools)
	fix(fix)
	evaluate(evaluate)
	tune(tune)
	supervisor(supervisor)
	submit(submit)
	__end__([<p>__end__</p>]):::last
	__start__ --> create_notebook;
	create_notebook --> tools;
	evaluate -.-> supervisor;
	evaluate -.-> tune;
	fix -.-> evaluate;
	fix -.-> tools;
	supervisor -.-> create_notebook;
	supervisor -.-> submit;
	tools -.-> evaluate;
	tools -.-> fix;
	tune -.-> evaluate;
	tune -.-> tools;
	submit --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
